# Example env file — DO NOT commit real secrets here.
# Use this as a template and set real values in Render (or .env.local for local dev).

# Frontend (Vite) — used at build time and available in browser bundle
VITE_BASE44_APP_ID=your_app_id_here
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app
VITE_BASE44_FUNCTIONS_VERSION=

# Server-side secret — DO NOT commit a production secret. Set this in Render Secrets.
# Example: JWT_SECRET=replace_with_a_strong_random_value
JWT_SECRET=changeme_development_secret

# Notes:
# - VITE_* variables are embedded into the frontend at build time. Ensure they are present during the build step on Render.
# - JWT_SECRET must be kept secret and set in Render's environment/secret settings, not in a public repo.
# - Remove this file before publishing real secrets.
